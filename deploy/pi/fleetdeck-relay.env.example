# deploy/pi/fleetdeck-relay.env.example
#
# Copy to the Pi and fill in real values:
#   sudo install -o root -g root -m 0600 deploy/pi/fleetdeck-relay.env.example /etc/fleetdeck-relay/relay.env
#
# /etc/fleetdeck-relay/relay.env MUST stay root-owned mode 0600. The
# fleetdeck-relay service user can read the variables via the service, but must
# never be able to modify the file. Never commit relay.env; this example is the
# only tracked copy and contains NO real secrets.
#
# The relay fails closed: without a usable RELAY_GITHUB_TOKEN it will not serve
# /v1/reports. See relay/README.md for the full contract.

# --- Service binding ----------------------------------------------------------
# Loopback ONLY. The Cloudflare Tunnel reaches the relay over 127.0.0.1; the
# relay must never bind a public address. Do not change RELAY_HOST.
RELAY_HOST=127.0.0.1
RELAY_PORT=8787

# --- Durable queue -------------------------------------------------------------
RELAY_DATA_DIR=/var/lib/fleetdeck-relay

# --- GitHub destination (fixed server-side; clients can never override) -------
RELAY_GITHUB_OWNER=Riloox
RELAY_GITHUB_REPO=fleetdeck-open
RELAY_GITHUB_LABELS=bug,in-app-report

# REQUIRED. A fine-grained PAT (Issues: read/write, Metadata: read-only,
# scoped to Riloox/fleetdeck-open ONLY) or a GitHub App installation token.
# Rotation procedure: deploy/pi/rotate-github-credential.md
RELAY_GITHUB_TOKEN=replace-with-fine-grained-token-scoped-to-fleetdeck-open

# --- Abuse controls -------------------------------------------------------------
RELAY_MAX_BODY_BYTES=32768
RELAY_RATE_LIMIT_PER_IP=10
RELAY_RATE_LIMIT_WINDOW_HOURS=1
RELAY_DAILY_BUDGET=500
RELAY_QUEUE_MAX_ATTEMPTS=5
RELAY_QUEUE_MAX_AGE_HOURS=24

# --- Logging ---------------------------------------------------------------------
RELAY_LOG_LEVEL=info
